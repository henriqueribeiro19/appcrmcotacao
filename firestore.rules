rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.perfil == 'admin';
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcessoApp']) &&
        request.resource.data.ultimoAcessoApp == request.time
      );
      allow delete: if isAdmin();
    }
    match /leads/{leadId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.responsavelId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.responsavelId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || (resource.data.responsavelId == request.auth.uid && request.resource.data.responsavelId == request.auth.uid));
      allow delete: if isAdmin();
    }
    match /staging/{id} {
      allow read, write: if isAdmin();
    }
    match /licencas_cloudfy/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /licencas_cplug/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /pacotes_cplug/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /categorias_canal/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /categorias_licencas_cloudfy/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /clientes_licencas_cloudfy/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /adicionais/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /cotacoes/{id} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.vendedorId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.vendedorId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || (resource.data.vendedorId == request.auth.uid && request.resource.data.vendedorId == request.auth.uid));
      allow delete: if isAdmin();
    }
    match /contract_templates/{templateId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /contracts/{contractId} {
      allow read: if isAuthenticated() && (isAdmin() || resource == null || resource.data.vendedorId == request.auth.uid);
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.vendedorId == request.auth.uid &&
          get(/databases/$(database)/documents/cotacoes/$(request.resource.data.cotacaoId)).data.status == 'aprovada' &&
          get(/databases/$(database)/documents/cotacoes/$(request.resource.data.cotacaoId)).data.vendedorId == request.auth.uid
        )
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.vendedorId == request.auth.uid &&
          request.resource.data.vendedorId == resource.data.vendedorId &&
          request.resource.data.cotacaoId == resource.data.cotacaoId &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['html', 'updatedAt', 'updatedBy']) ||
            (
              (
                !('tables' in resource.data) ||
                (
                  'licenses' in resource.data.tables &&
                  'services' in resource.data.tables &&
                  resource.data.tables.licenses.size() == 0 &&
                  resource.data.tables.services.size() == 0
                )
              ) &&
              'tables' in request.resource.data &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['html', 'tables', 'updatedAt'])
            ) ||
            (
              request.resource.data.version == resource.data.version + 1 &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'html', 'updatedAt', 'updatedBy', 'version', 'templateVersion',
                'tables', 'sourceFingerprint', 'clienteNome', 'numeroCotacao'
              ]) &&
              existsAfter(/databases/$(database)/documents/contracts/$(contractId)/versions/$(resource.data.version))
            )
          )
        )
      );
      allow delete: if isAdmin();

      match /versions/{versionId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/contracts/$(contractId)).data.vendedorId == request.auth.uid
        );
        allow create: if isAuthenticated() && (
          isAdmin() ||
          (
            request.resource.data.vendedorId == request.auth.uid &&
            get(/databases/$(database)/documents/contracts/$(contractId)).data.vendedorId == request.auth.uid &&
            request.resource.data.version == get(/databases/$(database)/documents/contracts/$(contractId)).data.version &&
            getAfter(/databases/$(database)/documents/contracts/$(contractId)).data.version ==
              get(/databases/$(database)/documents/contracts/$(contractId)).data.version + 1
          )
        );
        allow update, delete: if false;
      }
    }
  }
}
